<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:id="@+id/rootView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical">
<ImageButton android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_menu" android:tint="@color/text_primary" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Открыть разделы"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/sectionTitle" android:text="Подключение" android:textSize="22sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/modeHint" android:text="WireRoute" android:textSize="12sp" android:textColor="@color/text_secondary" />
</LinearLayout></LinearLayout>
<LinearLayout android:id="@+id/editingBlockedCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_recommended_card" android:padding="8dp" android:visibility="gone">
<TextView android:id="@+id/editingBlockedText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary"/>
<Button android:id="@+id/editingBlockedAction" style="@style/Widget.WireRoute.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><ScrollView android:id="@+id/connectionPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="visible"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_status_card" android:padding="24dp" android:gravity="center_horizontal" android:orientation="vertical">
<ImageView android:layout_width="96dp" android:layout_height="96dp" android:padding="20dp" android:background="@drawable/bg_icon_tile" android:src="@drawable/ic_connection" android:contentDescription="@null" android:tint="@color/accent"/>
<View android:id="@+id/statusDot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/statusText" android:text="@string/status_off" android:textSize="24sp" android:textColor="@color/text_primary" android:gravity="center" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/routeSummary" android:text="Выберите, что подключать к VPN" android:textSize="14sp" android:textColor="@color/text_secondary" android:gravity="center" android:layout_marginTop="10dp"/>
<Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/connectButton" style="@style/Widget.WireRoute.PrimaryButton" android:text="@string/connect" android:layout_marginTop="24dp"/>
<Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/connectionProfileButton" style="@style/Widget.WireRoute.OutlinedButton" android:text="Профиль подключения" android:layout_marginTop="10dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="За это подключение" android:textSize="14sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:layout_marginTop="24dp" android:layout_marginBottom="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="20dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/connectionReceived" android:text="Получено: —" android:textSize="16sp" android:textColor="@color/text_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/connectionSent" android:text="Отправлено: —" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/connectionNote" android:text="VPN работает для приложений с выбранным режимом." android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="16dp"/>
</LinearLayout></ScrollView><LinearLayout android:id="@+id/appsPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
<Spinner android:id="@+id/appCategory" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
<Button android:id="@+id/popularAppsButton" style="@style/Widget.WireRoute.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Подборка"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_search" android:gravity="center_vertical">
<ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_search" android:padding="12dp" android:contentDescription="@null" android:tint="@color/text_secondary"/>
<EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:singleLine="true" android:background="@null" android:hint="Найти приложение" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="15sp" android:importantForAutofill="no" android:imeOptions="actionDone"/>
<ImageButton android:id="@+id/clearSearchButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:padding="14dp" android:contentDescription="Очистить поиск" android:tint="@color/text_secondary" android:background="?android:attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
<RadioGroup android:id="@+id/appFilters" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_filters_group" android:padding="3dp" android:orientation="horizontal"><RadioButton android:id="@+id/filterAll" style="@style/Widget.WireRoute.FilterChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Все" android:checked="true"/><RadioButton android:id="@+id/filterVpn" style="@style/Widget.WireRoute.FilterChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="С VPN" /><RadioButton android:id="@+id/filterDirect" style="@style/Widget.WireRoute.FilterChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Без VPN" /></RadioGroup>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/selectedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_secondary"/>
<Button android:id="@+id/selectVisibleButton" style="@style/Widget.WireRoute.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Всем с VPN" android:textSize="13sp" android:singleLine="true" android:contentDescription="Всем показанным приложениям с VPN"/>
<Button android:id="@+id/clearVisibleButton" style="@style/Widget.WireRoute.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Всем без VPN" android:textSize="13sp" android:singleLine="true" android:contentDescription="Всем показанным приложениям без VPN"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ListView android:id="@+id/appsList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@color/transparent" android:dividerHeight="8dp" android:clipToPadding="false" android:paddingBottom="12dp"/>
<TextView android:id="@+id/appsEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Ничего не найдено" android:textSize="15sp" android:textColor="@color/text_secondary"/>
<ProgressBar android:id="@+id/appsProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone"/>
</FrameLayout></LinearLayout><ScrollView android:id="@+id/profilesPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Профили подключения" android:textSize="22sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Добавьте файл от своего VPN-провайдера." android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="18dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/configName" android:text="Профиль не добавлен" android:textSize="18sp" android:textColor="@color/text_primary" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/configDetails" android:text="Добавьте профиль, чтобы подключиться" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="6dp"/>
<Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/importButton" style="@style/Widget.WireRoute.OutlinedButton" android:text="Добавить профиль" android:layout_marginTop="12dp"/>
<Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/editProfileButton" style="@style/Widget.WireRoute.OutlinedButton" android:text="Редактировать подключение" android:layout_marginTop="8dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/profileLibrary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp"/>
</LinearLayout></ScrollView><ScrollView android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Для остальных приложений" android:textSize="20sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Ваши отдельные выборы сохранятся. Это правило для остальных и новых приложений." android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
<RadioGroup android:id="@+id/routingModes" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="12dp" android:orientation="vertical">
<RadioButton android:id="@+id/modeOnlySelected" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="Без VPN" android:textColor="@color/text_primary"/>
<RadioButton android:id="@+id/modeBypassSelected" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="С VPN" android:textColor="@color/text_primary"/>
</RadioGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Внешний вид" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_marginTop="24dp" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Светлая или тёмная тема выбирается вместе с темой телефона." android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Интернет от компьютера" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_marginTop="24dp" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"  android:text="Подключение через USB Bridge сохранено. Во время такого подключения VPN работает для всего телефона." android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/versionText" android:text="WireRoute" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="28dp"/>
</LinearLayout></ScrollView><ScrollView android:id="@+id/sitesPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="24dp"><LinearLayout android:id="@+id/sitesContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></LinearLayout></ScrollView></FrameLayout>
<LinearLayout android:id="@+id/pendingChangesCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/bg_recommended_card" android:visibility="gone">
<TextView android:id="@+id/pendingChangesText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Есть несохранённый выбор" android:textSize="13sp" android:textColor="@color/text_secondary"/>
<Button android:id="@+id/discardChangesButton" style="@style/Widget.WireRoute.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Отменить"/>
<Button android:id="@+id/applyChangesButton" style="@style/Widget.WireRoute.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Применить"/>
</LinearLayout></LinearLayout>
<include android:id="@+id/drawerView" layout="@layout/view_main_drawer" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start"/>
</androidx.drawerlayout.widget.DrawerLayout>
